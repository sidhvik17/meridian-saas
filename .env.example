# ---------------------------------------------------------------------------
# Meridian environment template.
# Copy to `.env` for local development. In production, inject these via your
# orchestrator's secret store (AWS Secrets Manager, Vault, etc.) — never from
# a file checked into the repository.
# ---------------------------------------------------------------------------

# Django core
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=.meridian.app
DJANGO_PUBLIC_HOSTS=meridian.app,www.meridian.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.meridian.app
DJANGO_ADMIN_URL=admin/
DJANGO_LOG_LEVEL=INFO

# Database (PostgreSQL)
POSTGRES_DB=meridian
POSTGRES_USER=meridian
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# TLS / proxy (production only; see SECURITY_AUDIT.md before changing)
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_BEHIND_TLS_PROXY=true
